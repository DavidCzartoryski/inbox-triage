# Secrets — .env holds ANTHROPIC_API_KEY and, on the IMAP backend, a password.
.env
.env.*
!.env.example

# Agent state. Contains senders, subjects and summaries of your real mail:
# private, and meaningless on any other machine.
state.json
state.tmp

# Learned verdicts. Contains your senders and subject shapes.
verdict_cache.json
*.tmp

# Cleanup tool output — generated, and also full of your real subject lines.
cleanup_plan.md
cleanup_plan.json
unsubscribe_candidates.json

# Your panel settings: filter choices and your personal sender allowlist.
config.json

# launchd/cron output
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# macOS
.DS_Store

# Job scout: recommendations, your yes/no decisions, and resume paths.
jobs_state.json
jobs_state.lock

# What you're looking for, sent to the model with your resume. Personal.
profile.md
