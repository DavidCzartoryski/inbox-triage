# Copy to .env, fill in, and keep it out of git.
# For the IMAP backend, prefer the macOS Keychain over this file:
#   security add-generic-password -a "you@icloud.com" -s "mail-triage" -w

# applescript = no credentials, macOS only (recommended)
# imap        = app password, runs anywhere
MAIL_BACKEND="applescript"

ANTHROPIC_API_KEY="sk-ant-..."
DIGEST_TO="you@icloud.com"

# IMAP backend only
MAIL_EMAIL="you@icloud.com"
MAIL_PROVIDER="icloud"          # icloud | gmail  (outlook needs OAuth, unsupported)
# MAIL_APP_PASSWORD="..."       # Keychain preferred; this is the fallback

# Optional
FILTERED_FOLDER="Filtered"
TRIAGE_MODEL="claude-sonnet-5"
MAIL_ACCOUNT="iCloud"           # account name as it appears in Mail.app
PROTECT_DAYS="30"               # cleanup: never touch mail newer than this

# Senders that are NEVER filed, comma-separated substring match.
NEVER_FILTER="@youruniversity.edu,advisor@,recruiting@"
