# Copy to .env, fill in, then `source .env`.
#
# Every line says `export` on purpose. A bare FOO="bar" is only a shell
# variable — `source`ing it leaves it invisible to python, and the agent would
# silently start up unconfigured.
#
# For the IMAP backend, prefer the macOS Keychain over this file:
#   security add-generic-password -a "you@icloud.com" -s "mail-triage" -w

# applescript = no credentials, macOS only (recommended)
# imap        = app password, runs anywhere
export MAIL_BACKEND="applescript"

export ANTHROPIC_API_KEY="sk-ant-..."
export DIGEST_TO="you@icloud.com"

# IMAP backend only
export MAIL_EMAIL="you@icloud.com"
export MAIL_PROVIDER="icloud"          # icloud | gmail  (outlook needs OAuth)
# export MAIL_APP_PASSWORD="..."       # Keychain preferred; this is the fallback

# Optional
export FILTERED_FOLDER="Filtered"
export TRIAGE_MODEL="claude-sonnet-5"
export MAIL_ACCOUNT="iCloud"           # account name as it appears in Mail.app
export PROTECT_DAYS="30"               # cleanup: never touch mail newer than this

# Senders that are NEVER filed, comma-separated substring match.
export NEVER_FILTER="@youruniversity.edu,advisor@,recruiting@"
